# ==============================================================
# Configuration du Bot Telegram d'Actualités IA - MxM Academy
# ==============================================================

# 1. Clé d'API Telegram (obtenue auprès de @BotFather)
TELEGRAM_BOT_TOKEN=

# 2. Identifiant du canal de publication (ex: @mon_canal ou -1001234567890)
# N'oublie pas d'ajouter ton bot comme administrateur du canal avec la permission de publier !
TELEGRAM_CHANNEL_ID=

# 3. ID Telegram de l'administrateur (optionnel)
TELEGRAM_ADMIN_ID=

# 4. Clé d'API Groq (GRATUITE pour DeepSeek R1 sur https://console.groq.com/keys)
GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3.8-27b

# 5. Clé d'API Google Gemini (alternative gratuite sur https://aistudio.google.com/)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# 6. Fréquence d'exécution automatique (en minutes)
FETCH_INTERVAL_MINUTES=30

# 7. Nombre maximum d'articles publiés par cycle
MAX_POSTS_PER_RUN=3

# 8. Note minimale d'intérêt IA pour publier (sur 10)
MIN_RELEVANCE_SCORE=7

# 9. Hashtag de la communauté
COMMUNITY_HASHTAG=#MxMAcademy
